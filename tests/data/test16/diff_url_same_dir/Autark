# Different versions of the same library are requested into the same target dir.
# This must be rejected before the second version overwrites the first one.

set {
  LIB_V1_URL
  ^{dir:// S{../fixtures/libext_v1}}
}

set {
  LIB_V2_URL
  ^{dir:// S{../fixtures/libext_v2}}
}

check {
  fetch_resource.sh { ${LIB_V1_URL} C{extern_lib} LIB_SRC_A }
  fetch_resource.sh { ${LIB_V2_URL} C{extern_lib} LIB_SRC_B }
}
