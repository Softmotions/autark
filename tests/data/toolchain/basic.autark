# Toolchain descriptor used by tests/test13.c
#
# Descriptor keys are data, not build rules: `cc` and `host-cc` below are plain
# key/value declarations even though Autark has build rules with the same names.
set {
  FAKE_NDK /nonexistent/ndk
}

toolchain {
  id       { test-arm64 }
  system   { Android }
  arch     { aarch64 }
  arch-alt { arm64 }
  bits     { 64 }
  endian   { Little }
  cc       { SS{tools/fake-cc.sh} }
  ar       { ar }
  cflags   { -DONE -DTWO=2 }
  host-cc  { cc }
  sysroot  { ^{${FAKE_NDK} /sysroot} }
  if { ${TEST_TOOLCHAIN_EXTRA} extra { extra-value } }
}
